# Modelo de ambiente de DESENVOLVIMENTO local.
#
# Copie para `.env` (`.env` é ignorado pelo Git e nunca é versionado).
# Todos os valores abaixo são descartáveis e servem apenas para a stack local
# do `compose.yaml`. Nenhuma credencial real de produção entra neste arquivo.

NODE_ENV=development

# Banco `db` do compose.yaml, publicado em 5432.
DATABASE_URL=postgres://designer_inox:desenvolvimento_local@127.0.0.1:5432/designer_inox

# Segredo sintético de desenvolvimento. Em produção use um valor aleatório de
# 32 caracteres ou mais, guardado no cofre de segredos da plataforma.
PAYLOAD_SECRET=desenvolvimento_local_segredo_32c

# Sincronização automática de schema. Permanece `false` fora de teste; o banco
# de desenvolvimento evolui pelas mesmas migrações versionadas de produção.
PAYLOAD_TEST_SCHEMA_SYNC=false
