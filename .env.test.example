# Modelo de ambiente de TESTE.
#
# Copie para `.env.test` (ignorado pelo Git).
# O banco precisa terminar em `_test`: tanto `getServerEnv` quanto o adapter do
# Payload recusam sincronização de schema em qualquer outro nome, para que uma
# execução de teste nunca alcance o banco de desenvolvimento ou de produção.

NODE_ENV=test

# Banco `db-test` do compose.yaml, publicado em 5433 e sem volume persistente.
DATABASE_URL=postgres://designer_inox:desenvolvimento_local@127.0.0.1:5433/designer_inox_test

PAYLOAD_SECRET=teste_local_segredo_com_32_caract

# Ligado apenas aqui: a suíte de integração monta o schema direto do config.
# Os testes de migração forçam esta flag para `false` e usam exclusivamente as
# migrações versionadas.
PAYLOAD_TEST_SCHEMA_SYNC=true
