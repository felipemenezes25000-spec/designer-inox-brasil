# Designer Inox Brasil — política de dependências
#
# Gerenciador único: npm 11.9.0. pnpm e yarn não são suportados.
# Instalação sempre com --ignore-scripts; após o gate de auditoria, apenas os
# módulos nativos abaixo podem reconstruir binários, via `npm rebuild` explícito:
#
#   sharp    — pipeline de imagem do Payload/Next
#   esbuild  — bundler usado por Vite/Vitest
#
# Nenhum outro pacote tem autorização para executar lifecycle scripts.

engine-strict=true
save-exact=true
fund=false
audit-level=high
